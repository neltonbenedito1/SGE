# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Stripe API Keys (SaaS Payment Gateway)
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_sample_key
STRIPE_SECRET_KEY=sk_test_sample_key
STRIPE_WEBHOOK_SECRET=whsec_sample_key

# QR Code Cryptographic Signing
QR_SIGNING_SECRET=sysedu_qr_hmac_secret_key_default_fallback_2026

# PDF Access Signing
PDF_SIGNING_SECRET=sysedu_pdf_signing_secret_2026

# SMTP Server Configurations
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_USER=postmaster@sysedu.edu.mz
SMTP_PASS=sample_password
SMTP_FROM=nao-responder@sysedu.edu.mz
EMAIL_MODE=production # production | simulation
