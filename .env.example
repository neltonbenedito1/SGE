# ==============================================================================
# SYSEDU SAAS - ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# NUNCA comite arquivos .env reais contendo segredos de produção.
# ==============================================================================

# Ambiente de Execução (production | development)
NODE_ENV=production

# URL canônica da aplicação e origens CORS permitidas (separadas por vírgula)
APP_URL=https://sysedu.edu.mz
CORS_ALLOWED_ORIGINS=https://sysedu.edu.mz,https://admin.sysedu.edu.mz

# 1. Gemini AI API Key (Injetado pelo ambiente de execução ou secret manager)
# ROTAÇÃO: Gerar nova chave no Google AI Studio / Google Cloud Vertex AI
GEMINI_API_KEY=AIzaSy_YOUR_GEMINI_API_KEY_HERE

# 2. Firebase Public Config (Apenas chaves públicas de cliente no frontend)
VITE_FIREBASE_API_KEY=AIzaSy_PUBLIC_CLIENT_KEY
VITE_FIREBASE_AUTH_DOMAIN=sentinel-fef50.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=sentinel-fef50
VITE_FIREBASE_STORAGE_BUCKET=sentinel-fef50.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=294856242899
VITE_FIREBASE_APP_ID=1:294856242899:web:e0f1825a34de1d135fc626

# 3. Firebase Admin / Server credentials
FIREBASE_PROJECT_ID=sentinel-fef50
FIREBASE_API_KEY=AIzaSy_SERVER_REST_KEY

# 4. Stripe API Keys (SaaS Payment Gateway)
# ROTAÇÃO: Rotacionar imediatamente no Stripe Dashboard -> Developers -> API Keys
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_sample_public_key
STRIPE_SECRET_KEY=sk_test_sample_secret_key
STRIPE_WEBHOOK_SECRET=whsec_sample_webhook_secret

# 5. Criptografia em Repouso & Assinaturas Criptográficas (HMAC-SHA256 & AES-256-GCM)
# Chaves de 256 bits (32 bytes). ROTAÇÃO: Gerar via `openssl rand -hex 32`
FIELD_ENCRYPTION_KEY=generate_random_64_hex_characters_for_aes_256_gcm
QR_SIGNING_SECRET=generate_random_64_hex_characters_for_qr_hmac
PDF_SIGNING_SECRET=generate_random_64_hex_characters_for_pdf_tokens

# 6. Autenticação SuperAdmin & Salting
AUTH_SALT=generate_random_32_bytes_salt
SUPERADMIN_PASSWORD_HASH=generate_pbkdf2_sha512_hash_with_100000_iterations

# 7. Gateway de E-mail SMTP (Nodemailer seguro)
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_USER=postmaster@sysedu.edu.mz
SMTP_PASS=your_strong_smtp_password
SMTP_FROM=nao-responder@sysedu.edu.mz
EMAIL_MODE=production # production | simulation
