rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return isAuthenticated() && (
        request.auth.token.email == 'neltonbenedito1@gmail.com' ||
        request.auth.token.role == 'super_admin'
      );
    }

    function getUserTenant() {
      return request.auth.token.tenant_id;
    }

    function isTenantMember(tenantId) {
      return isSuperAdmin() || (isAuthenticated() && getUserTenant() == tenantId);
    }

    // Default deny
    match /{allPaths=**} {
      allow read, write: if false;
    }

    // User profile pictures / avatars
    match /users/{userId}/{allPaths=**} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && (request.auth.uid == userId || isSuperAdmin())
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp|gif)');
    }

    // Tenant scoped documents, logos, school books, PDFs and digital materials
    match /tenants/{tenantId}/{allPaths=**} {
      allow read: if isTenantMember(tenantId);
      allow write: if isTenantMember(tenantId)
        && request.resource.size < 50 * 1024 * 1024
        && (
          request.resource.contentType.matches('image/(jpeg|png|webp|gif)') ||
          request.resource.contentType == 'application/pdf'
        );
    }
  }
}
