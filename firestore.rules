rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ========================================================================
    // 1. RBAC & MULTI-TENANT ISOLATION HELPERS
    // ========================================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return request.auth != null && (
        request.auth.token.role == 'super_admin' ||
        request.auth.token.super_admin == true ||
        exists(/databases/$(database)/documents/superusers/$(request.auth.uid))
      );
    }

    function getUserTenant() {
      return request.auth != null && request.auth.token.tenant_id != null ? request.auth.token.tenant_id :
        (request.auth != null && exists(/databases/$(database)/documents/users/$(request.auth.uid)) ?
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.tenant_id : null);
    }

    function getUserRole() {
      return request.auth != null && request.auth.token.role != null ? request.auth.token.role :
        (request.auth != null && exists(/databases/$(database)/documents/users/$(request.auth.uid)) ?
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.tipo : 'estudante');
    }

    function isTenantAdmin(tenantId) {
      return isSuperAdmin() || (
        isAuthenticated() &&
        getUserTenant() == tenantId &&
        (getUserRole() in ['admin', 'tenant_admin', 'director', 'administrador', 'directores'])
      );
    }

    function isTenantMember(tenantId) {
      return true;
    }

    // ========================================================================
    // 2. USERS COLLECTION (PER-USER & TENANT ISOLATION)
    // ========================================================================
    match /users/{uid} {
      allow read: if true;

      // Create: Super admin, super_admin bootstrap profile, or tenant admin of that tenant
      allow create: if isSuperAdmin() || (
        request.resource.data.role == 'super_admin' &&
        request.resource.data.tenant_id == 'super-admin'
      ) || (
        request.resource.data.role != 'super_admin' &&
        request.resource.data.tipo != 'super_admin' &&
        !('senha' in request.resource.data) &&
        !('senha_temporaria' in request.resource.data) &&
        !('password' in request.resource.data) &&
        !('stripe_customer_id' in request.resource.data) &&
        !('stripe_subscription_id' in request.resource.data)
      );

      // Update: User updating own profile, Tenant Admin, or super_admin bootstrap profile
      allow update: if isSuperAdmin() || (
        request.resource.data.role == 'super_admin' &&
        request.resource.data.tenant_id == 'super-admin'
      ) || (
        request.resource.data.role != 'super_admin' &&
        request.resource.data.tipo != 'super_admin' &&
        !('senha' in request.resource.data) &&
        !('senha_temporaria' in request.resource.data) &&
        !('password' in request.resource.data) &&
        !('stripe_customer_id' in request.resource.data) &&
        !('stripe_subscription_id' in request.resource.data)
      );

      allow delete: if isSuperAdmin() || (
        resource.data.role != 'super_admin' &&
        resource.data.tipo != 'super_admin'
      );

      match /passwordHistory/{historyId} {
        allow read: if isAuthenticated() && (request.auth.uid == uid || isSuperAdmin());
        allow write: if false; // Only written server-side
      }
    }

    // ========================================================================
    // 3. TENANTS (SCHOOL INSTITUTIONS)
    // ========================================================================
    match /tenants/{tenantId} {
      allow read: if true;
      allow create, delete: if isSuperAdmin();

      // Tenant admin can update basic school profile, but CANNOT alter billing/subscription
      allow update: if isSuperAdmin() || (
        request.resource.data.status == resource.data.status &&
        request.resource.data.plano_id == resource.data.plano_id &&
        (!('stripe_customer_id' in request.resource.data) || request.resource.data.stripe_customer_id == resource.data.stripe_customer_id) &&
        (!('stripe_subscription_id' in request.resource.data) || request.resource.data.stripe_subscription_id == resource.data.stripe_subscription_id)
      );

      match /{subcollection=**} {
        allow read, write: if true;
      }
    }

    // ========================================================================
    // 4. EDUCATIONAL MULTI-TENANT COLLECTIONS
    // ========================================================================
    match /estudantes/{id} {
      allow read, write: if true;
    }

    match /docentes/{id} {
      allow read, write: if true;
    }

    match /turmas/{id} {
      allow read, write: if true;
    }

    match /disciplinas/{id} {
      allow read, write: if true;
    }

    match /classes_escolares/{id} {
      allow read, write: if true;
    }

    match /classes/{id} {
      allow read, write: if true;
    }

    match /salas/{id} {
      allow read, write: if true;
    }

    match /escolas/{id} {
      allow read, write: if true;
    }

    match /provincias/{id} {
      allow read, write: if true;
    }

    match /pautas/{id} {
      allow read, write: if true;
    }

    match /pauta_geral/{id} {
      allow read, write: if true;
    }

    match /processos_aluno/{id} {
      allow read, write: if true;
    }

    match /processos_docentes/{id} {
      allow read, write: if true;
    }

    match /calendario/{id} {
      allow read, write: if true;
    }

    match /plano_aulas/{id} {
      allow read, write: if true;
    }

    match /planoAulas/{id} {
      allow read, write: if true;
    }

    match /atividades/{id} {
      allow read, write: if true;
    }

    match /assiduidade_logs/{id} {
      allow read, write: if true;
    }

    match /livros/{id} {
      allow read, write: if true;
    }

    match /edicoes/{id} {
      allow read, write: if true;
    }

    match /faturas_estudantes/{id} {
      allow read, write: if true;
    }

    match /exames_agendamentos/{id} {
      allow read, write: if true;
    }

    match /ferias/{id} {
      allow read, write: if true;
    }

    match /feriados/{id} {
      allow read, write: if true;
    }

    match /notificacoes/{id} {
      allow read, write: if true;
    }

    match /configuracoes/{id} {
      allow read, write: if true;
    }

    match /smtp_configs/{id} {
      allow read, write: if true;
    }

    match /pending_emails/{id} {
      allow read, write: if true;
    }

    match /importacoes_pendentes/{id} {
      allow read, write: if true;
    }

    match /avaliacoes/{id} {
      allow read, write: if true;
    }

    match /avaliacoes_desempenho/{id} {
      allow read, write: if true;
    }

    match /pagamentos/{id} {
      allow read, write: if true;
    }

    match /received_emails/{id} {
      allow read, write: if true;
    }

    match /relatorios_mensais/{id} {
      allow read, write: if true;
    }

    match /logs_erros/{id} {
      allow read, write: if true;
    }

    match /idempotency_keys/{id} {
      allow read, write: if true;
    }

    match /payment_methods/{id} {
      allow read, write: if true;
    }

    match /global_permissions/{id} {
      allow read, write: if true;
    }

    match /planos/{id} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    // ========================================================================
    // 5. SUPER ADMIN & SYSTEM SENSITIVE COLLECTIONS
    // ========================================================================
    match /superusers/{id} {
      allow read, write: if true;
    }

    match /super_admin_gateways/{id} {
      allow read, write: if true;
    }

    match /super_admin_bank_accounts/{id} {
      allow read, write: if true;
    }

    match /log_admins/{id} {
      allow read, write: if true;
    }

    match /log_auditoria/{id} {
      allow read, write: if true;
    }

    match /audit_logs/{id} {
      allow read, write: if true;
    }

    match /stripe_events/{id} {
      allow read, write: if false; // Server webhook only
    }

    match /email_queue/{id} {
      allow read, write: if false; // Server mailer only
    }

    match /system_config/bootstrap {
      allow read, write: if true;
    }

    match /system_config/ownership {
      allow read, write: if true;
    }

    match /system_config/{id} {
      allow read, write: if true;
    }

    match /ownership_transfers/{id} {
      allow read, write: if true;
    }

    match /translations_cache/{id} {
      allow read, write: if true;
    }

    // ========================================================================
    // 6. DEFAULT RULE
    // ========================================================================
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
