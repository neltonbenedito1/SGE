rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return isAuthenticated() && (
        request.auth.token.email == 'neltonbenedito1@gmail.com' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'super_admin' ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.tipo == 'super_admin'
        )) ||
        exists(/databases/$(database)/documents/superusers/$(request.auth.uid))
      );
    }

    // ========================================================================
    // USERS COLLECTION & SUBCOLLECTIONS
    // ========================================================================
    match /users/{uid} {
      allow read, write: if true;

      match /passwordHistory/{historyId} {
        allow read, write: if true;
      }
    }

    // ========================================================================
    // SUPER ADMIN & SYSTEM CONFIGURATIONS
    // ========================================================================
    match /superusers/{id} {
      allow read, write: if true;
    }

    match /super_admin_gateways/{id} {
      allow read, write: if true;
    }

    match /super_admin_bank_accounts/{id} {
      allow read, write: if true;
    }

    match /planos/{id} {
      allow read, write: if true;
    }

    match /pagamentos/{id} {
      allow read, write: if true;
    }

    match /tenants/{tenantId} {
      allow read, write: if true;

      match /{subcollection=**} {
        allow read, write: if true;
      }
    }

    match /notificacoes/{id} {
      allow read, write: if true;
    }

    match /log_admins/{id} {
      allow read, write: if true;
    }

    match /log_auditoria/{id} {
      allow read, write: if true;
    }

    match /test/{id} {
      allow read, write: if true;
    }

    // All tenant and educational collections & general documents
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
