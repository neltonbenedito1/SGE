{
  "entities": {
    "SuperUser": {
      "title": "SuperUser",
      "description": "Super Admin administrator of the SaaS portal",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "email": { "type": "string" },
        "nome": { "type": "string" },
        "role": { "type": "string" },
        "created_at": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "email", "nome", "role"]
    },
    "Tenant": {
      "title": "Tenant",
      "description": "Educational institution tenant subscription",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "nome": { "type": "string" },
        "slug": { "type": "string" },
        "plano_id": { "type": "string" },
        "status": { "type": "string", "enum": ["ativo", "suspenso", "cancelado", "pendente_pagamento"] },
        "data_vencimento": { "type": "string" },
        "data_renovacao": { "type": "string" },
        "created_at": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "nome", "slug", "plano_id", "status", "data_vencimento"]
    },
    "Plano": {
      "title": "Plano",
      "description": "SaaS Subscription plan limits and price",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "nome": { "type": "string" },
        "descricao": { "type": "string" },
        "preco": { "type": "number" },
        "periodicidade": { "type": "string" },
        "modulos_permitidos": { "type": "array" },
        "limits": { "type": "object" }
      },
      "required": ["id", "nome", "preco", "periodicidade", "modulos_permitidos"]
    },
    "Pagamento": {
      "title": "Pagamento",
      "description": "Invoice/Payment records of tenants",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "tenant_id": { "type": "string" },
        "valor": { "type": "number" },
        "data_vencimento": { "type": "string" },
        "data_pagamento": { "type": "string" },
        "status": { "type": "string" },
        "metodo": { "type": "string" }
      },
      "required": ["id", "tenant_id", "valor", "data_vencimento", "status"]
    },
    "User": {
      "title": "User",
      "description": "Tenant-specific user record with role permissions and custom claims reference",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "tenant_id": { "type": "string" },
        "email": { "type": "string" },
        "nome": { "type": "string" },
        "tipo": { "type": "string", "enum": ["admin", "director", "docente", "pai", "estudante", "finance", "super_admin"] },
        "permissoes": { "type": "array" },
        "ativo": { "type": "boolean" },
        "mustChangePassword": { "type": "boolean" },
        "created_at": { "type": "string" }
      },
      "required": ["id", "tenant_id", "email", "nome", "tipo", "ativo"]
    },
    "Escola": {
      "title": "Escola",
      "description": "School within a tenant",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "tenant_id": { "type": "string" },
        "provincia_id": { "type": "string" },
        "nome": { "type": "string" },
        "endereco": { "type": "string" },
        "telefone": { "type": "string" },
        "email": { "type": "string" },
        "diretor_id": { "type": "string" },
        "ativo": { "type": "boolean" }
      },
      "required": ["id", "tenant_id", "provincia_id", "nome", "ativo"]
    },
    "AuditLog": {
      "title": "AuditLog",
      "description": "Immutable append-only audit trail",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "actor_id": { "type": "string" },
        "actor_email": { "type": "string" },
        "actor_role": { "type": "string" },
        "action": { "type": "string" },
        "entity": { "type": "string" },
        "entity_id": { "type": "string" },
        "tenant_id": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "actor_id", "action", "entity", "entity_id", "tenant_id", "timestamp"]
    },
    "LogErro": {
      "title": "LogErro",
      "description": "Structured system diagnostics and error log",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "origem": { "type": "string" },
        "mensagem": { "type": "string" },
        "severidade": { "type": "string" },
        "status": { "type": "string" },
        "created_at": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "origem", "mensagem", "severidade", "status", "created_at"]
    },
    "PlanoAula": {
      "title": "PlanoAula",
      "description": "Lesson plan topic or curriculum unit for teacher tracking",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "tenantId": { "type": "string" },
        "docenteId": { "type": "string" },
        "disciplinaId": { "type": "string" },
        "turmaId": { "type": "string" },
        "topico": { "type": "string" },
        "periodoTipo": { "type": "string", "enum": ["semestre", "trimestre"] },
        "periodoNumero": { "type": "number" },
        "anoLectivo": { "type": "string" },
        "dataPrevista": { "type": "string" },
        "status": { "type": "string", "enum": ["pendente", "lecionado"] },
        "dataLecionada": { "type": "string" },
        "extraordinario": { "type": "boolean" },
        "aulaCalendarioId": { "type": "string" },
        "ordem": { "type": "number" },
        "notificadoEm": { "type": "string" },
        "notificadoPor": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" },
        "createdBy": { "type": "string" }
      },
      "required": ["tenantId", "docenteId", "disciplinaId", "topico", "periodoTipo", "periodoNumero", "anoLectivo", "status", "extraordinario"]
    },
    "TenantAnalyticsAggregate": {
      "title": "TenantAnalyticsAggregate",
      "description": "Pre-calculated analytics summary per tenant updated via domain events",
      "type": "object",
      "properties": {
        "tenant_id": { "type": "string" },
        "schema_version": { "type": "number" },
        "updated_at": { "type": "string", "format": "date-time" },
        "totais": { "type": "object" },
        "aproveitamento": { "type": "object" },
        "assiduidade": { "type": "object" },
        "modulos": { "type": "object" },
        "capacidade_por_curso": { "type": "object" },
        "ocupacao_por_sala": { "type": "object" },
        "por_escola": { "type": "object" }
      },
      "required": ["tenant_id", "schema_version", "updated_at", "totais"]
    },
    "Estudante": {
      "title": "Estudante",
      "description": "Tenant-partitioned student record",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "tenant_id": { "type": "string" },
        "escola_id": { "type": "string" },
        "turma_id": { "type": "string" },
        "curso_id": { "type": "string" },
        "nome": { "type": "string" },
        "ativo": { "type": "boolean" },
        "created_at": { "type": "string" }
      },
      "required": ["id", "tenant_id", "nome"]
    },
    "Notificacao": {
      "title": "Notificacao",
      "description": "Tenant-isolated system notification",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "tenant_id": { "type": "string" },
        "destinatario_id": { "type": "string" },
        "destinatario_role": { "type": "string" },
        "titulo": { "type": "string" },
        "mensagem": { "type": "string" },
        "lido": { "type": "boolean" },
        "created_at": { "type": "string", "format": "date-time" }
      },
      "required": ["tenant_id", "destinatario_id", "titulo", "mensagem", "created_at"]
    },
    "AsyncJob": {
      "title": "AsyncJob",
      "description": "Idempotent background processing job partitioned by tenant_id",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "tenant_id": { "type": "string" },
        "type": { "type": "string", "enum": ["bulk_notification", "email_send", "report_generate", "pdf_generate", "ai_task", "stripe_webhook"] },
        "title": { "type": "string" },
        "status": { "type": "string", "enum": ["pendente", "em_processamento", "concluido", "falhado_reintento", "dead_letter"] },
        "progress": { "type": "number" },
        "progress_message": { "type": "string" },
        "idempotency_key": { "type": "string" },
        "attempts": { "type": "number" },
        "max_attempts": { "type": "number" },
        "next_run_at": { "type": "number" },
        "created_at": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "tenant_id", "type", "status", "progress", "idempotency_key", "created_at"]
    },
    "AsyncJobDeadLetter": {
      "title": "AsyncJobDeadLetter",
      "description": "Dead-letter queue record for permanently failed async jobs",
      "type": "object",
      "properties": {
        "job_id": { "type": "string" },
        "tenant_id": { "type": "string" },
        "type": { "type": "string" },
        "last_error": { "type": "string" },
        "failed_at": { "type": "string", "format": "date-time" }
      },
      "required": ["job_id", "tenant_id", "type", "last_error", "failed_at"]
    },
    "ServerSessionRecord": {
      "title": "ServerSessionRecord",
      "description": "Distributed session mirror for cross-replica verification and revocation",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "role": { "type": "string" },
        "tenantId": { "type": "string" },
        "createdAt": { "type": "number" },
        "lastActivity": { "type": "number" },
        "expiresAt": { "type": "number" },
        "revoked": { "type": "boolean" }
      },
      "required": ["userId", "role", "tenantId", "createdAt", "lastActivity"]
    },
    "TenantQuotaBucket": {
      "title": "TenantQuotaBucket",
      "description": "Distributed per-tenant plan usage quota counter",
      "type": "object",
      "properties": {
        "tenant_id": { "type": "string" },
        "quota_type": { "type": "string" },
        "count": { "type": "number" },
        "limit": { "type": "number" },
        "updated_at": { "type": "string", "format": "date-time" }
      },
      "required": ["tenant_id", "quota_type", "count", "limit"]
    }
  },
  "firestore": {
    "/superusers/{id}": {
      "schema": { "$ref": "#/entities/SuperUser" },
      "description": "Super admin metadata"
    },
    "/tenants/{id}": {
      "schema": { "$ref": "#/entities/Tenant" },
      "description": "Educational SaaS customer tenants"
    },
    "/planos/{id}": {
      "schema": { "$ref": "#/entities/Plano" },
      "description": "SaaS plan types and limitations"
    },
    "/pagamentos/{id}": {
      "schema": { "$ref": "#/entities/Pagamento" },
      "description": "SaaS tenant payment records"
    },
    "/users/{id}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "System users with role and tenant isolation"
    },
    "/escolas/{id}": {
      "schema": { "$ref": "#/entities/Escola" },
      "description": "Schools within tenants"
    },
    "/estudantes/{id}": {
      "schema": { "$ref": "#/entities/Estudante" },
      "description": "Students partitioned by tenant_id"
    },
    "/notificacoes/{id}": {
      "schema": { "$ref": "#/entities/Notificacao" },
      "description": "Notifications partitioned by tenant_id"
    },
    "/audit_logs/{id}": {
      "schema": { "$ref": "#/entities/AuditLog" },
      "description": "Immutable audit entries"
    },
    "/logs_erros/{id}": {
      "schema": { "$ref": "#/entities/LogErro" },
      "description": "System runtime diagnostics"
    },
    "/planoAulas/{id}": {
      "schema": { "$ref": "#/entities/PlanoAula" },
      "description": "Lesson planning topics and execution status"
    },
    "/tenant_analytics/{tenantId}": {
      "schema": { "$ref": "#/entities/TenantAnalyticsAggregate" },
      "description": "Pre-aggregated tenant administrative analytics"
    },
    "/async_jobs/{jobId}": {
      "schema": { "$ref": "#/entities/AsyncJob" },
      "description": "Tenant-isolated background job queue"
    },
    "/async_jobs_dlq/{jobId}": {
      "schema": { "$ref": "#/entities/AsyncJobDeadLetter" },
      "description": "Dead-letter queue for failed async jobs"
    },
    "/server_sessions/{sessionHash}": {
      "schema": { "$ref": "#/entities/ServerSessionRecord" },
      "description": "Distributed stateless session revocation and sliding expiry mirror"
    },
    "/tenant_quotas/{bucketKey}": {
      "schema": { "$ref": "#/entities/TenantQuotaBucket" },
      "description": "Distributed plan quota usage buckets partitioned by tenant_id"
    }
  }
}

